flowchart LR
  classDef data fill:#DBEAFE,stroke:#2563EB,color:#1E3A8A;
  classDef process fill:#CCFBF1,stroke:#0F766E,color:#134E4A;
  classDef model fill:#EDE9FE,stroke:#7C3AED,color:#4C1D95;
  classDef eval fill:#FEF3C7,stroke:#D97706,color:#92400E;
  classDef error fill:#FEE2E2,stroke:#DC2626,color:#7F1D1D;
  classDef infra fill:#E5E7EB,stroke:#6B7280,color:#111827;

  subgraph SRC["src/"]
    train["train_models.py"]
    dp["data_preprocessing.py"]
    fe["feature_engineering.py"]
    ev["evaluate.py"]
    app["app.py"]
  end

  subgraph DATA["data/"]
    tr[(UNSW_NB15_training-set_updated.csv)]
    te[(UNSW_NB15_testing-set_updated.csv)]
    comp[(model_comparison.csv)]
  end

  subgraph MOD["models/"]
    mBest[(best_model.pkl)]
    mPrep[(preprocessor.pkl)]
    mScale[(scaler.pkl)]
    mPca[(pca.pkl)]
  end

  subgraph OUT["outputs/"]
    o1[(before_smote.png)]
    o2[(after_smote.png)]
    o3[(correlation_heatmap.png)]
    o4[(feature_importance.png)]
    o5[(model_comparison.png)]
  end

  tr -->|load_data| train
  te -->|load_data| train

  dp -->|load_data, preprocess_features, apply_smote, scale_features| train
  fe -->|correlation_heatmap, feature_importance, apply_pca| train
  ev -->|evaluate_model| train

  train --> comp
  train --> mBest
  train --> mPrep
  train --> mScale
  train --> mPca
  train --> o1
  train --> o2
  train --> o3
  train --> o4
  train --> o5

  mBest -->|joblib.load| app
  mPrep -->|joblib.load| app
  mScale -->|joblib.load| app
  mPca -->|joblib.load| app
  o1 -->|display if present| app
  o2 -->|display if present| app
  o3 -->|display if present| app
  o4 -->|display if present| app
  o5 -->|display if present| app

  class tr,te,comp,o1,o2,o3,o4,o5 data;
  class train,dp,fe,ev,app process;
  class mBest,mPrep,mScale,mPca model;
  class SRC,DATA,MOD,OUT infra;
