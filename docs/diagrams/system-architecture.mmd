flowchart LR
  %% ---------- Styles ----------
  classDef data fill:#DBEAFE,stroke:#2563EB,color:#1E3A8A,stroke-width:1px;
  classDef process fill:#CCFBF1,stroke:#0F766E,color:#134E4A,stroke-width:1px;
  classDef model fill:#EDE9FE,stroke:#7C3AED,color:#4C1D95,stroke-width:1px;
  classDef eval fill:#FEF3C7,stroke:#D97706,color:#92400E,stroke-width:1px;
  classDef error fill:#FEE2E2,stroke:#DC2626,color:#7F1D1D,stroke-width:1px;
  classDef infra fill:#E5E7EB,stroke:#6B7280,color:#111827,stroke-width:1px;

  %% ---------- Offline Training ----------
  subgraph OFF["Offline Training Boundary"]
    direction LR

    subgraph DL["Data Layer"]
      train[(🗂️ data/UNSW_NB15_training-set_updated.csv)]
      test[(🗂️ data/UNSW_NB15_testing-set_updated.csv)]
    end

    subgraph PL["Processing Layer"]
      split["🧩 Split X/y\nDrop: id, stcpb, dtcpb"]
      prep["🧹 ColumnTransformer\nnum passthrough + OHE"]
      smote["⚖️ SMOTE (train only)"]
      scale["📏 StandardScaler(with_mean=False)"]
      pca["🧭 PCA(n_components=20)"]
    end

    subgraph ML["Machine Learning Layer"]
      candidates["🧠 8 Candidate Classifiers"]
      tune["🔧 cross_val_score + GridSearchCV"]
      gate{"🏆 Select Best\nMacro F1 → Attack Recall → Accuracy"}
    end

    subgraph AS["Artifact Storage Layer"]
      best[(💾 models/best_model.pkl)]
      pre[(💾 models/preprocessor.pkl)]
      sc[(💾 models/scaler.pkl)]
      p[(💾 models/pca.pkl)]
      cmp[(📊 data/model_comparison.csv)]
      imgs[(🖼️ outputs/*.png)]
    end

    train --> split
    test --> split
    split --> prep --> smote --> scale --> pca --> candidates --> tune --> gate
    gate --> best
    prep --> pre
    scale --> sc
    pca --> p
    tune --> cmp
    tune --> imgs
  end

  %% ---------- Online Inference ----------
  subgraph ON["Application & Inference Boundary"]
    direction LR
    user["👤 Analyst"]
    upload[(📤 CSV Upload)]
    app["🖥️ Streamlit App\nsrc/app.py"]
    infer["🔮 transform → predict"]
    output["📈 Table, metrics, pie chart"]
    fail["🚨 st.error / st.warning"]

    user --> upload --> app --> infer --> output
    app --> fail
  end

  pre --> app
  sc --> app
  p --> app
  best --> app
  app -. missing or incompatible artifacts .-> fail

  %% ---------- Legend ----------
  subgraph L["Legend"]
    direction TB
    l1["Blue: data inputs / files"]
    l2["Teal: preprocessing / transforms"]
    l3["Purple: ML models / artifacts"]
    l4["Amber: evaluation outputs"]
    l5["Red: validation/runtime errors"]
    l6["Gray: users / system boundaries"]
  end

  class train,test,upload,cmp,imgs data;
  class split,prep,smote,scale,pca,infer process;
  class candidates,tune,gate,best,pre,sc,p model;
  class output,l1,l2,l3,l4,l5,l6 eval;
  class fail error;
  class user,app,OFF,ON,DL,PL,ML,AS,L infra;
