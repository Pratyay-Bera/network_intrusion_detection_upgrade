flowchart LR
  classDef data fill:#DBEAFE,stroke:#2563EB,color:#1E3A8A;
  classDef process fill:#CCFBF1,stroke:#0F766E,color:#134E4A;
  classDef model fill:#EDE9FE,stroke:#7C3AED,color:#4C1D95;
  classDef eval fill:#FEF3C7,stroke:#D97706,color:#92400E;
  classDef error fill:#FEE2E2,stroke:#DC2626,color:#7F1D1D;
  classDef infra fill:#E5E7EB,stroke:#6B7280,color:#111827;

  subgraph OFF["Offline Training Flow"]
    direction LR
    d0[(📄 Train/Test CSV)] --> d1["✅ pd.read_csv"]
    d1 --> d2["🧩 X/y split"]
    d2 --> d3["🗑️ Drop id, stcpb, dtcpb"]
    d3 --> d4["🧹 Fit/transform ColumnTransformer"]
    d4 --> d5["⚖️ SMOTE on X_train only"]
    d5 --> d6["📏 Fit scaler on train"]
    d6 --> d7["🧭 Fit PCA on train"]
    d7 --> d8["🧠 Train + tune candidate models"]
    d8 --> d9["🏆 Select best model"]
    d9 --> d10[(💾 Save model artifacts)]
    d8 --> d11[(📊 Save evaluation CSV/plots)]
  end

  subgraph ON["Online Batch Inference Flow (Streamlit)"]
    direction LR
    u0[(📤 User CSV)] --> u1["🔍 Read + trim column names"]
    u1 --> u2{"Input usable?"}
    u2 -->|No| uErr["🚨 st.error / st.warning"]
    u2 -->|Yes| u3["🧩 Drop optional label\nDrop id, stcpb, dtcpb"]
    u3 --> u4["🧹 preprocessor.transform"]
    u4 --> u5["📏 scaler.transform"]
    u5 --> u6["🧭 pca.transform"]
    u6 --> u7["🔮 best_model.predict"]
    u7 --> u8{"Pred classes ⊆ {0,1}?"}
    u8 -->|No| uErr
    u8 -->|Yes| u9["🛡️ Map 0=Normal, 1=Potential Attack"]
    u9 --> u10["📈 Show table, metrics, pie, download"]
  end

  d10 -. artifacts loaded at runtime .-> u4

  class d0,u0,d10,d11 data;
  class d1,d2,d3,d4,d5,d6,d7,u1,u3,u4,u5,u6,u9,u10 process;
  class d8,d9,u7,u8 model;
  class uErr error;
  class OFF,ON,u2 infra;
